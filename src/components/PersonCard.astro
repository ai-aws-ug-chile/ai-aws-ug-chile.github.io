---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  person: CollectionEntry<'organizers'>;
}

const { person } = Astro.props;
const { data } = person;
const { Content } = await render(person);

const initials = data.name
  .split(' ')
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase();

const links = [
  { key: 'linkedin', label: 'LinkedIn', href: data.links.linkedin },
  { key: 'github', label: 'GitHub', href: data.links.github },
  { key: 'bluesky', label: 'Bluesky', href: data.links.bluesky },
  { key: 'website', label: 'Sitio web', href: data.links.website },
].filter((link) => link.href);
---

<article>
  {
    data.photo ? (
      <Image
        src={data.photo}
        alt={`Foto de ${data.name}`}
        width={200}
        height={200}
        class="h-20 w-20 object-cover"
        loading="lazy"
      />
    ) : (
      <div
        class="bg-night-900 text-cream-50 dark:bg-cream-200 dark:text-night-950 flex h-20 w-20 items-center justify-center text-xl font-bold"
        aria-hidden="true"
      >
        {initials}
      </div>
    )
  }

  <h3 class="mt-5 text-lg leading-snug font-bold">{data.name}</h3>
  <p class="label text-brand-700 dark:text-brand-400 mt-1.5">{data.role}</p>

  <div class="text-night-600 dark:text-cream-300 mt-3 leading-relaxed">
    <Content />
  </div>

  {
    links.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="label text-night-500 hover:text-brand-700 dark:hover:text-brand-400 transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

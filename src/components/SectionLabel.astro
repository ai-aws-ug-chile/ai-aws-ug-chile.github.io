---
interface Props {
  /** Two-digit section number, e.g. "01". */
  number?: string;
  /** Optional link rendered at the right end of the rule. */
  href?: string;
  linkLabel?: string;
  /**
   * Renders as <h2>. Set false when the section has its own headline below,
   * so the two do not compete as sibling headings.
   */
  heading?: boolean;
}

const { number, href, linkLabel, heading = true } = Astro.props;
const Tag = heading ? 'h2' : 'p';
---

{/* A numbered rule, the way a printed programme announces a section. */}
<div class="rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 pt-4">
  <Tag class="label flex items-baseline gap-3">
    {number && <span class="text-brand-700 dark:text-brand-400">{number}</span>}
    <span class="text-night-600 dark:text-cream-300"><slot /></span>
  </Tag>

  {
    href && (
      <a
        href={href}
        class="label text-night-500 hover:text-brand-700 dark:text-night-500 dark:hover:text-brand-400 transition-colors"
      >
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

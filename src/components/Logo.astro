---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// The illustrated pudú does not survive 36px; this keeps what still reads.
---

<svg
  class={className}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="AI AWS UG Chile"
>
  <path
    d="M11 4.5h18L38 20l-9 15.5H11L2 20z"
    class="fill-night-800 stroke-brand-500"
    stroke-width="2.4"
    stroke-linejoin="round"></path>

  {/* Cordillera */}
  <path d="M9 26.5l6.5-9 4.5 6 4-5.5 6.5 8.5z" class="fill-cream-100"></path>
  <path d="M13.4 20.2l2.1-2.7 2 2.7-2 .9z" class="fill-white"></path>
  <path d="M28.4 22.2l-2.4-3.2-1.9 2.6 2 1z" class="fill-white"></path>

  {/* Constellation */}
  <g class="stroke-brand-400" stroke-width="1.1" stroke-linecap="round">
    <path d="M9.5 13.5l3.5-2.5M13 11l3.5 1.5"></path>
  </g>
  <circle cx="9.5" cy="13.5" r="1.5" class="fill-brand-400"></circle>
  <circle cx="13" cy="11" r="1.5" class="fill-brand-400"></circle>
  <circle cx="16.5" cy="12.5" r="1.5" class="fill-brand-400"></circle>

  <circle cx="28.5" cy="11.5" r="1.2" class="fill-fawn-400"></circle>
  <circle cx="31.5" cy="14.5" r="0.8" class="fill-cream-100"></circle>
</svg>
